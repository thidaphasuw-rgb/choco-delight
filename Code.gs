/** Choco Delight Google Apps Script backend.
 * Setup: paste into Apps Script bound to your spreadsheet; run setup() once.
 * Set ADMIN_KEY in Script Properties. Deploy as Web App, Execute as Me, access Anyone.
 */
const PRODUCTS_SHEET='Products'; const ORDERS_SHEET='Orders'; const ITEMS_SHEET='Order_Items';
function setup(){const ss=SpreadsheetApp.getActiveSpreadsheet();ensureSheet_(ss,PRODUCTS_SHEET,['SKU','Product_Name','Price','Stock','Image_URL','Description','Category','Status']);ensureSheet_(ss,ORDERS_SHEET,['Order_ID','Created_At','Customer_Name','Phone','Address','Postcode','Note','Total','Status']);ensureSheet_(ss,ITEMS_SHEET,['Order_ID','SKU','Product_Name','Quantity','Unit_Price','Subtotal']);PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',ss.getId());if(!PropertiesService.getScriptProperties().getProperty('ADMIN_KEY'))PropertiesService.getScriptProperties().setProperty('ADMIN_KEY',Utilities.getUuid());Logger.log('Setup complete. Admin key: '+PropertiesService.getScriptProperties().getProperty('ADMIN_KEY'));}
function ensureSheet_(ss,name,headers){let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0)sh.appendRow(headers);return sh;}
function getSS_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');return id?SpreadsheetApp.openById(id):SpreadsheetApp.getActiveSpreadsheet();}
function doGet(e){const action=(e.parameter.action||'products').toLowerCase();if(action==='products')return json_({products:getProducts_()});if(action==='orders'){if(!authorized_(e.parameter.key))return json_({success:false,message:'Unauthorized'});return json_({orders:getOrders_()});}if(action==='orderitems'){if(!authorized_(e.parameter.key))return json_({success:false,message:'Unauthorized'});return json_({items:getOrderItems_()});}return json_({success:false,message:'Unknown action'});}
function doPost(e){try{const body=JSON.parse(e.postData.contents||'{}');if(body.action==='createOrder')return json_(createOrder_(body));if(body.action==='updateStatus'){if(!authorized_(body.key))return json_({success:false,message:'Unauthorized'});updateStatus_(body.orderId,body.status);return json_({success:true});}return json_({success:false,message:'Unknown action'});}catch(err){return json_({success:false,message:String(err)});}}
function getProducts_(){const sh=getSS_().getSheetByName(PRODUCTS_SHEET);if(!sh||sh.getLastRow()<2)return[];const values=sh.getDataRange().getDisplayValues(),heads=values.shift();return values.filter(r=>r[0]).map(r=>{let o={};heads.forEach((h,i)=>o[h]=r[i]);o.Price=Number(o.Price)||0;o.Stock=Number(o.Stock)||0;return o;});}
function createOrder_(body){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const products=getProducts_(),customer=body.customer||{},items=body.items||[];if(!customer.name||!customer.phone||!customer.address||!customer.postcode||!items.length)throw new Error('กรุณากรอกข้อมูลลูกค้าและรายการสินค้าให้ครบ');let lineItems=[],total=0;items.forEach(it=>{const p=products.find(x=>x.SKU===it.SKU);const q=Number(it.quantity);if(!p||!Number.isInteger(q)||q<1)throw new Error('รายการสินค้าผิดพลาด');if(p.Stock<q)throw new Error('สินค้า '+p.Product_Name+' มีไม่เพียงพอ');lineItems.push({p,q});total+=p.Price*q;});const ss=getSS_(),orders=ss.getSheetByName(ORDERS_SHEET),detail=ss.getSheetByName(ITEMS_SHEET),prod=ss.getSheetByName(PRODUCTS_SHEET);const orderId='CD-'+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyMMdd-HHmmss')+'-'+Math.floor(Math.random()*900+100);orders.appendRow([orderId,new Date(),customer.name,customer.phone,customer.address,customer.postcode,customer.note||'',total,'Pending']);lineItems.forEach(({p,q})=>{detail.appendRow([orderId,p.SKU,p.Product_Name,q,p.Price,p.Price*q]);const row=findSkuRow_(prod,p.SKU);if(row)prod.getRange(row,4).setValue(p.Stock-q);});return{success:true,orderId,total};}finally{lock.releaseLock();}}
function findSkuRow_(sh,sku){const vals=sh.getRange(2,1,Math.max(sh.getLastRow()-1,1),1).getValues();for(let i=0;i<vals.length;i++)if(vals[i][0]===sku)return i+2;return null;}
function getOrders_(){const sh=getSS_().getSheetByName(ORDERS_SHEET);if(!sh||sh.getLastRow()<2)return[];const vals=sh.getDataRange().getValues(),h=vals.shift();return vals.map(r=>{let o={};h.forEach((x,i)=>o[x]=r[i]);o.Created_At=o.Created_At instanceof Date?o.Created_At.toISOString():String(o.Created_At);return o;}).reverse();}
function getOrderItems_(){const sh=getSS_().getSheetByName(ITEMS_SHEET);if(!sh||sh.getLastRow()<2)return[];const vals=sh.getDataRange().getValues(),h=vals.shift();return vals.map(r=>{let o={};h.forEach((x,i)=>o[x]=r[i]);return o;});}
function updateStatus_(id,status){const allowed=['Pending','Picking','Packed','Shipped','Cancelled'];if(!allowed.includes(status))throw new Error('Invalid status');const sh=getSS_().getSheetByName(ORDERS_SHEET),vals=sh.getDataRange().getValues();for(let i=1;i<vals.length;i++)if(vals[i][0]===id){sh.getRange(i+1,9).setValue(status);return;}throw new Error('Order not found');}
function authorized_(key){return !!key&&key===PropertiesService.getScriptProperties().getProperty('ADMIN_KEY');}
function json_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
